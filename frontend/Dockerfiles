FROM node:18-alpine

WORKDIR /app

# Создаём все необходимые директории
RUN mkdir -p src/components src/contexts src/assets

# Записываем package.json
RUN echo '{"name":"discord-frontend","version":"1.0.0","private":true,"dependencies":{"react":"^18.2.0","react-dom":"^18.2.0","react-router-dom":"^6.8.0","axios":"^1.3.4","socket.io-client":"^4.5.4","react-icons":"^4.8.0","emoji-mart":"^5.5.2","react-dropzone":"^14.2.3","react-modal":"^3.16.1","styled-components":"^5.3.6","react-scripts":"5.0.1"},"scripts":{"start":"react-scripts start","build":"react-scripts build"},"browserslist":{"production":[">0.2%","not dead","not op_mini all"],"development":["last 1 chrome version","last 1 firefox version","last 1 safari version"]}}' > package.json

# Устанавливаем зависимости
RUN npm install

# Создаём .env
RUN echo 'REACT_APP_API_URL=http://localhost:5000\nREACT_APP_SOCKET_URL=http://localhost:5000' > .env

# Создаём index.css
RUN echo '*{margin:0;padding:0;box-sizing:border-box}body{font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif;background:#313338;color:#fff;overflow:hidden}::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:#1e1f22}::-webkit-scrollbar-thumb{background:#2b2d31;border-radius:3px}' > src/index.css

# Создаём index.js
RUN echo 'import React from "react";import ReactDOM from "react-dom/client";import "./index.css";import App from "./App";const root=ReactDOM.createRoot(document.getElementById("root"));root.render(<App />);' > src/index.js

# Создаём App.js
RUN echo 'import React from "react";import {BrowserRouter,Routes,Route,Navigate} from "react-router-dom";import {AuthProvider} from "./contexts/AuthContext";import {SocketProvider} from "./contexts/SocketContext";import Login from "./components/Login";import Register from "./components/Register";import Main from "./components/Main";import ProtectedRoute from "./components/ProtectedRoute";function App(){return(<AuthProvider><SocketProvider><BrowserRouter><Routes><Route path="/login" element={<Login />}/><Route path="/register" element={<Register />}/><Route path="/app/*" element={<ProtectedRoute><Main /></ProtectedRoute>}/><Route path="*" element={<Navigate to="/login" />}/></Routes></BrowserRouter></SocketProvider></AuthProvider>);}export default App;' > src/App.js

# Создаём AuthContext.js
RUN echo 'import React,{createContext,useState,useContext,useEffect} from "react";import axios from "axios";const AuthContext=createContext();export const AuthProvider=({children})=>{const [user,setUser]=useState(null);const [token,setToken]=useState(localStorage.getItem("token"));useEffect(()=>{if(token){axios.defaults.headers.common["Authorization"]=`Bearer ${token}`;axios.get(`${process.env.REACT_APP_API_URL}/api/auth/me`).then(res=>setUser(res.data.user)).catch(()=>logout());}},[token]);const login=(t,u)=>{setToken(t);setUser(u);localStorage.setItem("token",t);axios.defaults.headers.common["Authorization"]=`Bearer ${t}`;};const logout=()=>{setToken(null);setUser(null);localStorage.removeItem("token");delete axios.defaults.headers.common["Authorization"];};return(<AuthContext.Provider value={{user,token,login,logout}}>{children}</AuthContext.Provider>);};export const useAuth=()=>useContext(AuthContext);' > src/contexts/AuthContext.js

# Создаём SocketContext.js
RUN echo 'import React,{createContext,useContext,useEffect,useState} from "react";import io from "socket.io-client";import {useAuth} from "./AuthContext";const SocketContext=createContext();export const SocketProvider=({children})=>{const {token}=useAuth();const [socket,setSocket]=useState(null);useEffect(()=>{if(token){const newSocket=io(process.env.REACT_APP_SOCKET_URL,{auth:{token}});setSocket(newSocket);return()=>newSocket.close();}},[token]);return(<SocketContext.Provider value={{socket}}>{children}</SocketContext.Provider>);};export const useSocket=()=>useContext(SocketContext);' > src/contexts/SocketContext.js

# Создаём Login.js
RUN echo 'import React,{useState} from "react";import {useAuth} from "../contexts/AuthContext";import axios from "axios";import {useNavigate} from "react-router-dom";export default function Login(){const [email,setEmail]=useState("");const [password,setPassword]=useState("");const {login}=useAuth();const navigate=useNavigate();const handleSubmit=async(e)=>{e.preventDefault();try{const res=await axios.post(`${process.env.REACT_APP_API_URL}/api/auth/login`,{email,password});login(res.data.token,res.data.user);navigate("/app");}catch(err){alert("Ошибка входа");}};return(<div style={{display:"flex",justifyContent:"center",alignItems:"center",height:"100vh",background:"#313338"}}><form onSubmit={handleSubmit} style={{background:"#2b2d31",padding:"40px",borderRadius:"8px",width:"420px"}}><h2 style={{color:"white",marginBottom:"8px"}}>Добро пожаловать назад</h2><p style={{color:"#949ba4",marginBottom:"24px"}}>Мы так рады вас видеть!</p><input type="email" placeholder="Email" value={email} onChange={e=>setEmail(e.target.value)} style={{width:"100%",padding:"12px",margin:"8px 0",borderRadius:"4px",border:"none",background:"#1e1f22",color:"white"}}/><input type="password" placeholder="Пароль" value={password} onChange={e=>setPassword(e.target.value)} style={{width:"100%",padding:"12px",margin:"8px 0",borderRadius:"4px",border:"none",background:"#1e1f22",color:"white"}}/><button type="submit" style={{width:"100%",padding:"12px",marginTop:"16px",background:"#5865f2",color:"white",border:"none",borderRadius:"4px",fontWeight:"bold",fontSize:"16px"}}>Войти</button><p style={{color:"#949ba4",marginTop:"16px"}}>Нет аккаунта? <a href="/register" style={{color:"#5865f2"}}>Зарегистрироваться</a></p></form></div>);}' > src/components/Login.js

# Создаём Register.js
RUN echo 'import React,{useState} from "react";import {useAuth} from "../contexts/AuthContext";import axios from "axios";import {useNavigate} from "react-router-dom";export default function Register(){const [username,setUsername]=useState("");const [email,setEmail]=useState("");const [password,setPassword]=useState("");const {login}=useAuth();const navigate=useNavigate();const handleSubmit=async(e)=>{e.preventDefault();try{const res=await axios.post(`${process.env.REACT_APP_API_URL}/api/auth/register`,{username,email,password});login(res.data.token,res.data.user);navigate("/app");}catch(err){alert("Ошибка регистрации");}};return(<div style={{display:"flex",justifyContent:"center",alignItems:"center",height:"100vh",background:"#313338"}}><form onSubmit={handleSubmit} style={{background:"#2b2d31",padding:"40px",borderRadius:"8px",width:"420px"}}><h2 style={{color:"white",marginBottom:"8px"}}>Создать аккаунт</h2><input type="text" placeholder="Имя пользователя" value={username} onChange={e=>setUsername(e.target.value)} style={{width:"100%",padding:"12px",margin:"8px 0",borderRadius:"4px",border:"none",background:"#1e1f22",color:"white"}}/><input type="email" placeholder="Email" value={email} onChange={e=>setEmail(e.target.value)} style={{width:"100%",padding:"12px",margin:"8px 0",borderRadius:"4px",border:"none",background:"#1e1f22",color:"white"}}/><input type="password" placeholder="Пароль" value={password} onChange={e=>setPassword(e.target.value)} style={{width:"100%",padding:"12px",margin:"8px 0",borderRadius:"4px",border:"none",background:"#1e1f22",color:"white"}}/><button type="submit" style={{width:"100%",padding:"12px",marginTop:"16px",background:"#5865f2",color:"white",border:"none",borderRadius:"4px",fontWeight:"bold",fontSize:"16px"}}>Зарегистрироваться</button><p style={{color:"#949ba4",marginTop:"16px"}}>Уже есть аккаунт? <a href="/login" style={{color:"#5865f2"}}>Войти</a></p></form></div>);}' > src/components/Register.js

# Создаём ProtectedRoute.js
RUN echo 'import React from "react";import {Navigate} from "react-router-dom";import {useAuth} from "../contexts/AuthContext";export default function ProtectedRoute({children}){const {user}=useAuth();return user?children:<Navigate to="/login" />;}' > src/components/ProtectedRoute.js

# Создаём Main.js
RUN echo 'import React,{useState,useEffect} from "react";import {useAuth} from "../contexts/AuthContext";import {useSocket} from "../contexts/SocketContext";import ServerList from "./ServerList";import ChannelList from "./ChannelList";import Chat from "./Chat";import UserPanel from "./UserPanel";import axios from "axios";export default function Main(){const {user}=useAuth();const {socket}=useSocket();const [servers,setServers]=useState([]);const [selectedServer,setSelectedServer]=useState(null);const [channels,setChannels]=useState([]);const [selectedChannel,setSelectedChannel]=useState(null);useEffect(()=>{axios.get(`${process.env.REACT_APP_API_URL}/api/servers/mine`).then(res=>{setServers(res.data);if(res.data.length>0){setSelectedServer(res.data[0]);axios.get(`${process.env.REACT_APP_API_URL}/api/servers/${res.data[0].id}`).then(resp=>setChannels(resp.data.Channels||[]));}});},[]);useEffect(()=>{if(selectedServer&&socket){socket.emit("join-server",selectedServer.id);axios.get(`${process.env.REACT_APP_API_URL}/api/servers/${selectedServer.id}`).then(resp=>setChannels(resp.data.Channels||[]));}},[selectedServer,socket]);return(<div style={{display:"flex",height:"100vh",background:"#313338"}}><ServerList servers={servers} selectedServer={selectedServer} setSelectedServer={setSelectedServer} /><ChannelList channels={channels} selectedChannel={selectedChannel} setSelectedChannel={setSelectedChannel} server={selectedServer} /><Chat channel={selectedChannel} /><UserPanel user={user} /></div>);}' > src/components/Main.js

# Создаём ServerList.js
RUN echo 'import React,{useState} from "react";import {FaPlus} from "react-icons/fa";import axios from "axios";export default function ServerList({servers,selectedServer,setSelectedServer}){const [showModal,setShowModal]=useState(false);const [serverName,setServerName]=useState("");const createServer=async()=>{if(!serverName.trim())return;const res=await axios.post(`${process.env.REACT_APP_API_URL}/api/servers`,{name:serverName});setServers([...servers,res.data]);setSelectedServer(res.data);setShowModal(false);setServerName("");};return(<div style={{width:"72px",background:"#1e1f22",display:"flex",flexDirection:"column",alignItems:"center",padding:"12px 0",gap:"8px",overflowY:"auto"}}>{servers.map(s=>(<div key={s.id} onClick={()=>setSelectedServer(s)} style={{width:"48px",height:"48px",borderRadius:selectedServer?.id===s.id?"16px":"50%",background:"#5865f2",display:"flex",alignItems:"center",justifyContent:"center",fontWeight:"bold",fontSize:"18px",cursor:"pointer",transition:"0.2s",color:"white"}}>{s.name[0].toUpperCase()}</div>))}<div onClick={()=>setShowModal(true)} style={{width:"48px",height:"48px",borderRadius:"50%",background:"#2b2d31",display:"flex",alignItems:"center",justifyContent:"center",cursor:"pointer",color:"#3ba55c"}}><FaPlus size={24}/></div>{showModal&&(<div style={{position:"fixed",top:0,left:0,right:0,bottom:0,background:"rgba(0,0,0,0.7)",display:"flex",justifyContent:"center",alignItems:"center"}}><div style={{background:"#2b2d31",padding:"40px",borderRadius:"8px",width:"440px"}}><h3 style={{color:"white"}}>Создать сервер</h3><input value={serverName} onChange={e=>setServerName(e.target.value)} placeholder="Название сервера" style={{width:"100%",padding:"12px",marginTop:"16px",borderRadius:"4px",border:"none",background:"#1e1f22",color:"white"}}/><button onClick={createServer} style={{marginTop:"16px",padding:"12px 24px",background:"#5865f2",color:"white",border:"none",borderRadius:"4px",cursor:"pointer"}}>Создать</button><button onClick={()=>setShowModal(false)} style={{marginLeft:"8px",padding:"12px 24px",background:"#2b2d31",color:"#949ba4",border:"none",borderRadius:"4px",cursor:"pointer"}}>Отмена</button></div></div>)}</div>);}' > src/components/ServerList.js

# Создаём ChannelList.js
RUN echo 'import React from "react";import {FaHashtag,FaVolumeUp,FaPlus} from "react-icons/fa";export default function ChannelList({channels,selectedChannel,setSelectedChannel,server}){return(<div style={{width:"240px",background:"#2b2d31",display:"flex",flexDirection:"column",padding:"16px 8px"}}><div style={{color:"white",fontWeight:"bold",padding:"0 8px 16px",borderBottom:"1px solid #1e1f22"}}>{server?.name||"Сервер"}</div><div style={{paddingTop:"16px"}}><div style={{display:"flex",justifyContent:"space-between",color:"#949ba4",fontSize:"12px",padding:"0 8px"}}><span>Текстовые каналы</span><FaPlus size={12} style={{cursor:"pointer"}}/></div>{channels.filter(c=>c.type==="text").map(c=>(<div key={c.id} onClick={()=>setSelectedChannel(c)} style={{padding:"6px 8px",margin:"2px 0",borderRadius:"4px",background:selectedChannel?.id===c.id?"#404249":"transparent",color:selectedChannel?.id===c.id?"white":"#949ba4",cursor:"pointer",display:"flex",alignItems:"center",gap:"8px"}}><FaHashtag size={16}/> {c.name}</div>))}<div style={{marginTop:"16px",color:"#949ba4",fontSize:"12px",padding:"0 8px"}}>Голосовые каналы</div>{channels.filter(c=>c.type==="voice").map(c=>(<div key={c.id} style={{padding:"6px 8px",margin:"2px 0",borderRadius:"4px",color:"#949ba4",display:"flex",alignItems:"center",gap:"8px"}}><FaVolumeUp size={16}/> {c.name}</div>))}</div></div>);}' > src/components/ChannelList.js

# Создаём Chat.js
RUN echo 'import React,{useState,useEffect,useRef} from "react";import {useSocket} from "../contexts/SocketContext";import {useAuth} from "../contexts/AuthContext";import axios from "axios";import {FaSmile,FaPaperclip} from "react-icons/fa";import Picker from "emoji-mart";export default function Chat({channel}){const [messages,setMessages]=useState([]);const [input,setInput]=useState("");const [showEmoji,setShowEmoji]=useState(false);const {socket}=useSocket();const {user}=useAuth();const messagesEndRef=useRef(null);const typingTimeoutRef=useRef(null);useEffect(()=>{if(!channel)return;axios.get(`${process.env.REACT_APP_API_URL}/api/messages/channel/${channel.id}`).then(res=>setMessages(res.data));socket.emit("join-channel",channel.id);socket.on("new-message",(msg)=>{setMessages(prev=>[...prev,msg]);});socket.on("user-typing",({username})=>{});return()=>{socket.off("new-message");socket.off("user-typing");};},[channel,socket]);useEffect(()=>{messagesEndRef.current?.scrollIntoView({behavior:"smooth"});},[messages]);const sendMessage=()=>{if(!input.trim())return;socket.emit("send-message",{channelId:channel.id,userId:user.id,content:input,attachments:[]});setInput("");setShowEmoji(false);};const handleTyping=()=>{socket.emit("typing",{channelId:channel.id,username:user.username});clearTimeout(typingTimeoutRef.current);typingTimeoutRef.current=setTimeout(()=>{socket.emit("stop-typing",{channelId:channel.id});},2000);};if(!channel)return(<div style={{flex:1,display:"flex",justifyContent:"center",alignItems:"center",background:"#313338",color:"#949ba4"}}>Выберите канал</div>);return(<div style={{flex:1,display:"flex",flexDirection:"column",background:"#313338"}}><div style={{padding:"16px",borderBottom:"1px solid #1e1f22",color:"white",fontWeight:"bold",background:"#2b2d31"}}><FaHashtag style={{marginRight:"8px",color:"#949ba4"}}/> {channel.name}</div><div style={{flex:1,overflowY:"auto",padding:"16px",display:"flex",flexDirection:"column"}}>{messages.map((msg)=>(<div key={msg.id} style={{marginBottom:"8px",display:"flex",gap:"8px",alignItems:"flex-start"}}><img src={msg.User?.avatar||"/default-avatar.png"} style={{width:"32px",height:"32px",borderRadius:"50%"}} onError={(e)=>e.target.src="/default-avatar.png"}/><div><b style={{color:"white"}}>{msg.User?.username}</b><span style={{color:"#949ba4",fontSize:"11px",marginLeft:"8px"}}>{new Date(msg.createdAt).toLocaleTimeString()}</span><div style={{color:"#dbdee1"}}>{msg.content}</div></div></div>))}<div ref={messagesEndRef}/></div><div style={{padding:"16px",background:"#2b2d31",display:"flex",alignItems:"center",gap:"8px",position:"relative"}}><FaSmile size={24} color="#949ba4" onClick={()=>setShowEmoji(!showEmoji)} style={{cursor:"pointer"}}/><FaPaperclip size={20} color="#949ba4" style={{cursor:"pointer"}}/><input value={input} onChange={e=>setInput(e.target.value)} onKeyDown={e=>e.key==="Enter"&&sendMessage()} onInput={handleTyping} placeholder={`Сообщение в #${channel.name}`} style={{flex:1,padding:"12px",borderRadius:"8px",border:"none",background:"#1e1f22",color:"white",outline:"none"}}/>{showEmoji&&(<div style={{position:"absolute",bottom:"70px",right:"0px",zIndex:1000}}><Picker onSelect={(emoji)=>setInput(input+emoji.native)} theme="dark"/></div>)}</div></div>);}' > src/components/Chat.js

# Создаём UserPanel.js
RUN echo 'import React from "react";import {FaMicrophone,FaHeadphones,FaCog} from "react-icons/fa";import {useAuth} from "../contexts/AuthContext";export default function UserPanel({user}){const {logout}=useAuth();return(<div style={{height:"52px",background:"#1e1f22",display:"flex",alignItems:"center",padding:"0 16px",gap:"12px",borderTop:"1px solid #2b2d31"}}><img src={user?.avatar||"/default-avatar.png"} style={{width:"32px",height:"32px",borderRadius:"50%"}} onError={(e)=>e.target.src="/default-avatar.png"}/><div style={{flex:1}}><div style={{color:"white",fontSize:"14px",fontWeight:"bold"}}>{user?.username}</div><div style={{color:"#949ba4",fontSize:"11px"}}>#{user?.discriminator}</div></div><FaMicrophone style={{color:"#949ba4",cursor:"pointer"}}/><FaHeadphones style={{color:"#949ba4",cursor:"pointer"}}/><FaCog style={{color:"#949ba4",cursor:"pointer"}} onClick={logout}/></div>);}' > src/components/UserPanel.js

# Создаём дефолтную аватарку (пустой файл, чтобы не было 404)
RUN echo 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==' | base64 -d > src/assets/default-avatar.png

EXPOSE 3000

CMD ["npm", "start"]
